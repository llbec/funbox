# 必须替换为实际强密码，建议使用随机生成的十六进制字符串
REDIS_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD

# 宿主机监听地址：
# 仅本机访问用 127.0.0.1；
# 应用通过内网连接时，改为 Redis 服务器的实际内网 IP。
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=6379

# Redis 数据内存上限；达到上限后拒绝需要新增内存的写入，不淘汰队列消息
REDIS_MAXMEMORY=512mb

# 容器总内存上限，需给 Redis 进程、缓冲区及持久化操作留出空间
REDIS_CONTAINER_MEMORY=1g